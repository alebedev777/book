# VPS: домен для nginx (docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile miniapp)
# Первый SSL: ./scripts/init-letsencrypt.sh you@email.com
# DEPLOY_DOMAIN=book.example.com
# Тогда же: MINI_APP_URL, VITE_API_URL, API_PUBLIC_URL = https://book.example.com/ (и / без слэша для URL API)
# Подробно: docs/DEPLOY-VPS.md

# Telegram
BOT_TOKEN=
MINI_APP_URL=https://your-tunnel.trycloudflare.com/

# OpenAI: chat — OPENAI_BASE_URL; images — {OPENAI_BASE_URL}/images (в коде)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o
# Фото ребёнка: модель с vision (на RouterAI — gemini/qwen с multimodal)
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-1
MODERATE_CUSTOM_THEMES=true
MODERATE_STORY_TEXT=false

# Langfuse (локальный UI: http://localhost:3000 — Projects → API keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://book:book@localhost:5432/book
DATABASE_URL_SYNC=postgresql://book:book@localhost:5432/book

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=book-assets
S3_PUBLIC_URL=http://localhost:9000/book-assets

# App
API_PUBLIC_URL=http://localhost:8000
PHOTO_TTL_DAYS=30
MAX_PAGES=10
MVP_PAGES=4
RATE_LIMIT_ACTIVE_ORDERS=1

# Docker Compose (если 5432/6379/9000 заняты, напр. Langfuse)
BOOK_POSTGRES_PORT=5433
BOOK_REDIS_PORT=6380
BOOK_MINIO_PORT=9002
BOOK_MINIO_CONSOLE_PORT=9003
# BOOK_API_PORT=8000
# BOOK_MINIAPP_PORT=5173

# Сборка miniapp в Docker: публичный URL API для браузера пользователя
# VITE_API_URL=http://localhost:8000